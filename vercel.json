{
  "rewrites": [
    {
      "source": "/MLBMX.html",
      "destination": "/track.html"
    },
    {
      "source": "/register",
      "destination": "/registration.html"
    },
    {
      "source": "/tracks/moses-lake-bmx",
      "destination": "/track.html"
    },
    {
      "source": "/tracks/moses-lake-bmx/rider",
      "destination": "/track-rider.html"
    }
  ],
  "headers": [
    {
      "source": "/api/track",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/rider-assets/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/track.html",
      "destination": "/MLBMX.html",
      "permanent": true
    }
  ]
}
